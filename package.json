{
  "name": "actionplan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:rag": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-rag.ts",
    "test:rag": "node --import tsx --test tests/rag/*.test.ts",
    "eval:rag": "node --env-file-if-exists=.env.local --import tsx scripts/eval-rag.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.41.0",
    "lenis": "^1.3.23",
    "next": "16.2.2",
    "pdf-parse": "^1.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
